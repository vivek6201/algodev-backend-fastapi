# ==============================================
# Algorithmic Dev Backend - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values

# App Settings
PROJECT_NAME=Algorithmic Dev
VERSION=1.0.0
DEBUG=false
DOMAIN=localhost

# Server Settings
HOST=0.0.0.0
PORT=8000

# Security (REQUIRED)
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Token Expiration (in seconds)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database (REQUIRED)
# For Docker: postgresql://admin:admin123@postgres:5432/algorithmicdev
# For local: postgresql://admin:admin123@localhost:5432/algorithmicdev
DATABASE_URL=postgresql://admin:admin123@postgres:5432/algorithmicdev

# PostgreSQL (for docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=algorithmicdev
POSTGRES_PORT=5432

# Redis (optional)
REDIS_URL=

# Email - Resend (optional)
RESEND_API_KEY=

# AWS S3 & CloudFront (optional)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# CORS Origins (comma-separated in code, but loaded from settings.py defaults)
# Override in settings.py for production
